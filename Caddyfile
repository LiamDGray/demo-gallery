# Caddyfile for demo.liamdgray.com
# Installed at: ~/src/demo/Caddyfile
# Run with: caddy run --config ~/src/demo/Caddyfile

demo.liamdgray.com {

    # ── Public API routes (no token required) ────────────────
    # These must come BEFORE the auth handle block
    handle_path /api/* {
        reverse_proxy localhost:8090
    }

    # ── Intersect (public — free service for HN users) ──────
    route /intersect/* {
        reverse_proxy localhost:8010
    }

    # ── Landing page (no token required) ─────────────────────
    handle {
        root * /home/liam/src/demo/gallery
        file_server
    }

    # ── Token auth for all demo routes ───────────────────────
    # Every request to /geo-csg, /name-check, etc. must have a valid token
    route /geo-csg/* {
        forward_auth localhost:8090 {
            uri /verify
            header_up X-Original-URI {uri}
            header_up X-Original-Method {method}
        }
        reverse_proxy localhost:8001
    }

    route /voice-chat/* {
        forward_auth localhost:8090 {
            uri /verify
            header_up X-Original-URI {uri}
            header_up X-Original-Method {method}
        }
        reverse_proxy localhost:8766
    }

    route /name-check/* {
        forward_auth localhost:8090 {
            uri /verify
            header_up X-Original-URI {uri}
            header_up X-Original-Method {method}
        }
        reverse_proxy localhost:8002
    }

    route /agent-debate/* {
        forward_auth localhost:8090 {
            uri /verify
            header_up X-Original-URI {uri}
            header_up X-Original-Method {method}
        }
        reverse_proxy localhost:8006
    }

    route /realpeep/* {
        forward_auth localhost:8090 {
            uri /verify
            header_up X-Original-URI {uri}
            header_up X-Original-Method {method}
        }
        reverse_proxy localhost:8003
    }

    route /afterlife/* {
        forward_auth localhost:8090 {
            uri /verify
            header_up X-Original-URI {uri}
            header_up X-Original-Method {method}
        }
        reverse_proxy localhost:8004
    }

    route /artcall/* {
        forward_auth localhost:8090 {
            uri /verify
            header_up X-Original-URI {uri}
            header_up X-Original-Method {method}
        }
        reverse_proxy localhost:8005
    }

    route /behavioral/* {
        forward_auth localhost:8090 {
            uri /verify
            header_up X-Original-URI {uri}
            header_up X-Original-Method {method}
        }
        reverse_proxy localhost:8007
    }

    route /sigstead/* {
        forward_auth localhost:8090 {
            uri /verify
            header_up X-Original-URI {uri}
            header_up X-Original-Method {method}
        }
        reverse_proxy localhost:8008
    }

    route /loc3net/* {
        forward_auth localhost:8090 {
            uri /verify
            header_up X-Original-URI {uri}
            header_up X-Original-Method {method}
        }
        reverse_proxy localhost:8009
    }

    # ── Admin: token management (X-Admin-Key header auth, no token needed) ─
    handle_path /admin/* {
        reverse_proxy localhost:8090
    }

    # ── Error responses ─────────────────────────────────────
    handle_errors {
        respond "{err.status_code} {err.status_text}"
    }
}
